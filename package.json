{
  "name": "jobradar",
  "version": "0.1.0",
  "description": "JobRadar - Kenyan job discovery desktop app",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"npm:server\" \"vite\" \"wait-on tcp:5173 tcp:127.0.0.1:4317 && electron . --dev\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc -p tsconfig.json && vite build && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "server": "tsx server/index.ts",
    "db:clean-test": "tsx server/clean-test-data.ts",
    "collect:check": "tsx server/check.ts",
    "test": "node --import tsx --test server/pipeline.test.ts server/phase4.test.ts server/phase5.test.ts server/sources.test.ts",
    "build:server": "esbuild server/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-server/server.cjs --log-level=warning && node scripts/copy-wasm.cjs",
    "pack": "npm run build && npm run build:server && electron-builder --dir",
    "dist": "npm run build && npm run build:server && electron-builder --win nsis",
    "release": "npm run dist && node scripts/release.cjs"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "cheerio": "^1.2.0",
    "concurrently": "^8.2.2",
    "d3-geo": "^3.1.2",
    "electron": "^31.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.21.5",
    "express": "^5.3.0",
    "lucide-react": "^0.441.0",
    "mammoth": "^1.13.0",
    "postcss": "^8.4.41",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.15.2",
    "tailwindcss": "^3.4.10",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "unpdf": "^1.9.1",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0",
    "world-atlas": "^2.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "com.jobradar.app",
    "productName": "JobRadar",
    "artifactName": "JobRadar-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-server",
        "to": "server",
        "filter": [
          "server.cjs",
          "sql-wasm.wasm"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JobRadar",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "T-actician",
        "repo": "JobRadar"
      }
    ]
  },
  "author": "T-actician"
}
